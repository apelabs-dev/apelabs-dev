---
// Deck section 5: the honest proof. A labelled sample finding and two own builds, no client claims.
import SectionIndex from '../SectionIndex.astro';
import SampleReport from '../SampleReport.astro';
import { PROOF } from '../../lib/copy';

interface Props {
  pageHeading?: boolean;
}
const { pageHeading = false } = Astro.props;
const Heading = pageHeading ? 'h1' : 'h2';
const Sub = pageHeading ? 'h2' : 'h3';
---

<section class="section proof" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <SectionIndex index={PROOF.index} label={PROOF.label} />
    <div class="intro">
      <Heading class="h2" id="proof-title">{PROOF.h2}</Heading>
      <p class="lead body-muted">{PROOF.lead}</p>
    </div>

    <div class="sample">
      <SampleReport />
    </div>

    <div class="builds">
      <p class="label">{PROOF.builtLabel}</p>
      <ul class="rows">
        {PROOF.builds.map((b) => (
          <li class="row build">
            <Sub class="name">{b.name}</Sub>
            <dl>
              {b.rows.map((r) => (
                <div class="line">
                  <dt>{r.term}</dt>
                  <dd>{r.text}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
    </div>

    <p class="closing">{PROOF.closing}</p>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(40px, 6vw, 96px);
      align-items: end;
    }
  }
  .sample {
    margin-top: clamp(48px, 6vw, 80px);
  }
  .builds {
    margin-top: clamp(64px, 8vw, 112px);
  }
  .builds .rows {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .build {
    display: grid;
    gap: 16px;
    padding: 28px 0 32px;
  }
  .name {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 450;
    letter-spacing: 0;
    line-height: 1.3;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .line {
    display: grid;
    gap: 2px;
    font-size: var(--text-small);
    line-height: 1.55;
  }
  dt {
    color: var(--color-ink);
    font-weight: 560;
  }
  dd {
    margin: 0;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .build {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--grid-gap);
    }
    .line {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr);
      column-gap: var(--grid-gap);
    }
  }
  .closing {
    margin-top: 40px;
    max-width: 52em;
    color: var(--color-muted);
  }
</style>

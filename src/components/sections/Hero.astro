---
// Deck section 1. Copy left (~40%), trace right (~60%) on desktop; one column below 1024 with
// the CTA above the trace. The six replay chapters are one ordered list: a ruled strip under the
// hero in the static state, and the scroll chapters beside the pinned trace when the replay runs.
import RunTrace from '../RunTrace.astro';
import ColumnRules from '../ColumnRules.astro';
import Arrow from '../Arrow.astro';
import { HERO, TRACE } from '../../lib/copy';
import { CTA_LABEL, ctaHref } from '../../lib/site';

const path = Astro.url.pathname;
const sampleHref = path === '/' ? '#sample' : '/proof/#sample';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <ColumnRules />
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="eyebrow label"><span class="sq" aria-hidden="true"></span>{HERO.eyebrow}</p>
      <h1 id="hero-title">{HERO.h1}</h1>
      <p class="sub">{HERO.subhead}</p>
      <div class="actions">
        <a class="btn" href={ctaHref(path)}>{CTA_LABEL}<Arrow /></a>
        <a class="link" href={sampleHref}>{HERO.secondary}</a>
      </div>
      <p class="micro mono">{HERO.microline}</p>
    </div>

    <div class="stage">
      <RunTrace />
    </div>

    <ol class="chapters" data-chapters>
      {TRACE.chapters.map((c, i) => (
        <li class="chapter" data-step={i + 1}>
          <span class="num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p>
            <strong>{c.name}:</strong> {c.text}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "copy"
      "stage"
      "chapters";
    row-gap: clamp(40px, 6vw, 56px);
  }
  .copy {
    grid-area: copy;
    max-width: 640px;
  }
  .stage {
    grid-area: stage;
    min-width: 0;
  }
  .chapters {
    grid-area: chapters;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        "copy stage"
        "chapters chapters";
      column-gap: clamp(40px, 5vw, 72px);
      row-gap: 72px;
      align-items: start;
    }
    .copy {
      padding-top: 24px;
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
  }
  .sq {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
  }
  h1 {
    margin-top: 24px;
    font-size: var(--text-display);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .sub {
    margin-top: 24px;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-muted);
    max-width: 34em;
  }
  .actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }
  .micro {
    margin-top: 16px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-muted);
  }

  /* Chapters: the static captions of the replay. */
  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--color-rule-strong);
  }
  .chapter {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--color-muted);
  }
  .chapter strong {
    font-weight: 560;
    color: var(--color-ink);
  }
  .num {
    font-size: var(--text-label);
    line-height: 22px;
    color: var(--color-muted);
  }
  /* Orange marks the repair, green the verified rerun, as in the trace. */
  .chapter:nth-child(5) .num {
    color: var(--color-accent);
  }
  .chapter:nth-child(6) .num {
    color: var(--color-status);
  }
  @media (min-width: 768px) {
    .chapters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .chapter {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 20px 0 24px;
    }
  }
  @media (min-width: 1024px) {
    .chapters {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .chapter {
      border-bottom: 0;
    }
  }
</style>

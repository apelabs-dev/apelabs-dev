---
// Deck section 4: the free diagnostic. What we look at / get back / don't need / what happens
// next on the left, the request form on the right (620–720px column on desktop).
import SectionIndex from '../SectionIndex.astro';
import DiagnosticForm from '../DiagnosticForm.astro';
import { DIAGNOSTIC_COPY as D } from '../../lib/copy';

interface Props {
  pageHeading?: boolean;
}
const { pageHeading = false } = Astro.props;
const Heading = pageHeading ? 'h1' : 'h2';
---

<section class="section diagnostic" id="diagnostic" aria-labelledby="diagnostic-title">
  <div class="wrap">
    <SectionIndex index={D.index} label={D.label} />
    <div class="grid">
      <div class="info">
        <Heading class="h2" id="diagnostic-title">{D.h2}</Heading>
        <p class="lead">{D.lead}</p>

        <div class="block">
          <p class="label">{D.lookAtLabel}</p>
          <ul class="ticks">
            {D.lookAt.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="block">
          <p class="label">{D.getBackLabel}</p>
          <ul class="ticks">
            {D.getBack.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="block no-pass">
          <p>
            <strong>{D.dontNeedLabel}</strong> {D.dontNeed}
          </p>
        </div>

        <div class="block">
          <p class="label">{D.nextLabel}</p>
          <ol class="next">
            {D.next.map((item, i) => (
              <li>
                <span class="n mono" aria-hidden="true">{i + 1}</span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="form-col">
        <DiagnosticForm confirmLevel={pageHeading ? 'h2' : 'h3'} />
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(560px, 680px);
      column-gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
  }
  .lead {
    margin-top: 24px;
    color: var(--color-muted);
  }
  .block {
    margin-top: 40px;
  }
  .ticks,
  .next {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-strong);
  }
  .ticks li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    padding: 11px 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-small);
    line-height: 1.5;
  }
  .ticks li::before {
    content: "";
    width: 8px;
    height: 2px;
    margin-top: 0.72em;
    background: var(--color-ink);
    opacity: 0.6;
  }
  .no-pass {
    padding: 18px 20px;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
    font-size: var(--text-small);
    line-height: 1.55;
  }
  .no-pass strong {
    font-weight: 600;
  }
  .next li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    padding: 12px 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-small);
    line-height: 1.5;
  }
  .n {
    font-size: var(--text-data);
    color: var(--color-muted);
  }
</style>

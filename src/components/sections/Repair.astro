---
// Deck section 2: the primary service. Pain hook, H2, three symptom/check/result report rows,
// the repair flow diagram, the tools line and how repairs work.
import SectionIndex from '../SectionIndex.astro';
import RepairFlow from '../RepairFlow.astro';
import Arrow from '../Arrow.astro';
import { REPAIR } from '../../lib/copy';
import { CTA_LABEL, ctaHref } from '../../lib/site';

interface Props {
  /** On /repair/ the section heading is the page h1. */
  pageHeading?: boolean;
}
const { pageHeading = false } = Astro.props;
const Heading = pageHeading ? 'h1' : 'h2';
const cells = [
  ['Symptom', 'symptom'],
  ['What we check', 'check'],
  ['Result', 'result'],
] as const;
---

<section class="section repair" id="repair" aria-labelledby="repair-title">
  <div class="wrap">
    <SectionIndex index={REPAIR.index} label={REPAIR.label} />

    <div class="intro">
      <p class="hook">
        <span>{REPAIR.hook[0]}</span>
        <span>{REPAIR.hook[1]}</span>
      </p>
      <div class="intro-text">
        <Heading class="h-title" id="repair-title">{REPAIR.h2}</Heading>
        <p class="lead">{REPAIR.lead}</p>
      </div>
    </div>

    <ol class="rows report">
      {REPAIR.rows.map((row, i) => (
        <li class="row report-row">
          <span class="num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <dl>
            {cells.map(([term, key]) => (
              <div class={`cell cell--${key}`}>
                <dt class="label">{term}</dt>
                <dd>{row[key]}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ol>

    <div class="diagram">
      <RepairFlow />
    </div>

    <div class="terms">
      <div class="tools">
        <p class="tools-line">{REPAIR.tools}</p>
        <p class="body-muted">{REPAIR.otherStack}</p>
      </div>
      <div class="how">
        <p class="label">How repairs work</p>
        <ul>
          {REPAIR.how.map((line) => <li>{line}</li>)}
        </ul>
        <p class="care">{REPAIR.care}</p>
        <a class="btn" href={ctaHref(Astro.url.pathname)}>{CTA_LABEL}<Arrow /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    display: grid;
    gap: 40px;
  }
  .hook {
    display: grid;
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
  }
  .hook span + span {
    color: var(--color-muted);
  }
  .h-title {
    font-size: var(--text-h3);
    letter-spacing: -0.015em;
    line-height: 1.3;
    max-width: 34ch;
  }
  .intro-text .lead {
    margin-top: 20px;
    color: var(--color-muted);
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(40px, 6vw, 96px);
      align-items: end;
    }
  }

  /* Report rows */
  .report {
    list-style: none;
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
  }
  .report-row {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 12px;
    padding: 24px 0;
  }
  .num {
    font-size: var(--text-label);
    line-height: 14px;
    color: var(--color-muted);
  }
  dl {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  dd {
    margin: 6px 0 0;
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .cell--check dd,
  .cell--result dd {
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .report-row {
      grid-template-columns: 56px minmax(0, 1fr);
      padding: 28px 0 32px;
    }
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
  }

  .diagram {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .terms {
    margin-top: clamp(56px, 7vw, 96px);
    display: grid;
    gap: 48px;
  }
  .tools-line {
    font-size: var(--text-lead);
    line-height: 1.45;
    max-width: 36em;
  }
  .tools .body-muted {
    margin-top: 16px;
    max-width: 36em;
  }
  .how ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-rule-strong);
  }
  .how li {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .care {
    margin: 24px 0 32px;
    color: var(--color-muted);
  }
  @media (min-width: 1024px) {
    .terms {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(40px, 6vw, 96px);
    }
  }
</style>

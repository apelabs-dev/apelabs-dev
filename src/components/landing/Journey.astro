  /* ================================================================ notes in the picture */
  /* .cx-notes: in-flow text under its step; the board's .cx-layer (plates and leader) and .cx-row/.cx-row-lead
     (the diagnostic list in the run history). Without JS (no .cx-live) the notes are plain text and every picture
     layer stays hidden. With JS every note waits behind an orange dot (.cx-pin) that opens it; the leader, 1.5px
     paper at 85%, ends on the dot's edge. */

  .cx-notes {
    margin-top: 16px;
  }
  .cx-lead {
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;

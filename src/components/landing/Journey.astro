  }
  .jx .cx-layer .cx-plate.is-on[data-placed] {
    opacity: 1;
    transition-delay: 800ms;
  }
  .jx .cx-lead-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    transition: opacity 260ms var(--ease-out);

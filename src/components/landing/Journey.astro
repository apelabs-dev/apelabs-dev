  .jx .cx-layer:has(.cx-plate.is-on[data-placed]) .cx-lead-line {
    opacity: 1;
    transition-delay: 800ms;
  }

  /* Phones and tablets: the board is full, so a caption strip goes under it (the board keeps its size, the steps
     pin that much lower) and the plate docks there, its leader running up to the part. */
  @media (max-width: 1023px) {
    .jx.cx-live.jr-live {
      --cx-dock: 76px;
      --jx-stage-h: calc(clamp(300px, 50svh, 440px) + var(--cx-dock));

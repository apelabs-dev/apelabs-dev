  }

  /* The diagnostic list in the run history: what each row tells us, under its words. A ring on the row's line
     just before its words, a rule from the ring down the note. The rows' columns open up by 8px so the ring
     sits clear of the timestamp. */
  .jx.cx-live[data-scene='diag'] :is(.cx-row, .cx-row-lead) {
    display: block;
  }
  .jx.cx-live[data-scene='diag'] .jx-log li {
    column-gap: 20px;
    row-gap: 4px;
  }
  .jx .cx-row {
    --cx-rx: -10px; /* the rule's x: half the row's column gap, left of the words */
    --cx-up: 11px; /* the 4px row gap + half a 14px row line */
    position: relative;
    grid-column: 2 / -1;
    padding-left: 4px;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text);
    animation: cx-in 420ms var(--ease-out) both;
    animation-delay: calc(var(--k, 0) * 90ms);
  }
  /* The rule: from the ring's lower edge to the note's last line. */
  .jx .cx-row::before {
    content: '';
    position: absolute;
    left: calc(var(--cx-rx) - 0.75px);
    top: calc(-1 * var(--cx-up) + 5.5px);
    bottom: 2px;
    width: 1.5px;
    background: color-mix(in srgb, var(--color-paper) 85%, transparent);
  }
  /* The ring, centred on the row's text line (one row line up: --cx-up). */
  .jx .cx-row::after {
    content: '';
    position: absolute;
    left: calc(var(--cx-rx) - 5.5px);
    top: calc(-1 * var(--cx-up) - 5.5px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--color-orange);
    border-radius: 50%;
    background: var(--color-report);
  }
  .jx .cx-row-lead {
    --cx-lead-pad: 12px; /* the pin's x (notes.ts reads it) */
    padding: 8px 12px 0 var(--cx-lead-pad);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.04em;
    color: var(--color-text-3);
  }
  @container jxview (min-width: 560px) {
    .jx .cx-row {
      --cx-up: 13px; /* the 4px row gap + half an 18px row line */
      font-size: 13px;
      line-height: 18px;
    }
    .jx .cx-row-lead {
      --cx-lead-pad: 20px;
      padding-top: 14px;
      padding-right: 20px;
    }
  }
  @keyframes cx-in {
    from {
      opacity: 0;
    }
  }

  /* The note dot: the 6px orange status dot. While its note is closed a thin orange ring breathes round it, slowly
     (2.8s each way) and never fully out (10px to 16px across); open, the dot alone. Reduced motion: still. */
  .jx .cx-pin-mark {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
  }
  .jx .cx-pin-mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 1.5px solid color-mix(in srgb, var(--color-orange) 60%, transparent);
    border-radius: 50%;
    opacity: 0.6;
    pointer-events: none;
    animation: note-breathe 2.8s ease-in-out infinite alternate;
  }
  @keyframes note-breathe {
    from {
      opacity: 0.3;
      scale: 0.72;
    }
    to {
      opacity: 0.9;
      scale: 1.14;
    }
  }
  .jx .cx-pin.is-open .cx-pin-mark::after {
    display: none;
  }

  /* The reader's own press shows a note at once (the 800 ms wait is for the board's scene change). */
  .jx .cx-layer.is-now .cx-plate.is-on[data-placed],
  .jx .cx-layer.is-now:has(.cx-plate.is-on[data-placed]) .cx-lead-line {
    transition-delay: 0s;
  }

  .jx .cx-pin {
    position: absolute;
    z-index: 1;
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    pointer-events: auto;
    opacity: 0;
    transition: opacity 260ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  .jx .cx-pin[hidden] {
    display: none;
  }
  .jx .cx-pin[data-placed] {
    opacity: 1;
    transition-delay: 800ms;
  }
  .jx .cx-layer.is-now .cx-pin[data-placed] {
    transition-delay: 0s;
  }
  .jx :is(.cx-pin-mark, .cx-pin-label) {
    position: absolute;
  }
  .jx .cx-pin:focus-visible {
    outline: none;
  }
  .jx .cx-pin:focus-visible .cx-pin-mark {
    outline: 2px solid var(--color-orange);
    outline-offset: 3px;
  }
  /* "Reveal the note": a small chip on the board's dark, in the board's mono label type. */
  .jx .cx-pin-label {
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 34%, transparent);
    border-radius: 2px;
    background: var(--jx-desk);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 450;
    line-height: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .jx .cx-pin:is(:hover, :focus-visible) .cx-pin-label {
    border-color: color-mix(in srgb, var(--color-paper) 62%, transparent);
  }
  /* Where a pointer can hover, the label waits for it or for keyboard focus (hidden, it takes no hover either);
     where nothing can hover, it shows while the note is closed. */
  @media (hover: hover) {
    .jx .cx-pin-label {
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--dur-fast) var(--ease-out),
        visibility 0s linear var(--dur-fast);
    }
    .jx .cx-pin:is(:hover, :focus-visible) .cx-pin-label {
      visibility: visible;
      opacity: 1;
      transition-delay: 0s;
    }
  }
  /* Open: the dot alone. */
  .jx .cx-pin.is-open .cx-pin-label {
    visibility: hidden;
    opacity: 0;
    transition: none;
  }

  /* The run history (step 02): its dot sits on the lead line. Closed, the lead keeps its line, empty, and the rows
     stay out; open, the lead's words follow the dot. */
  .jx.cx-live .cx-row-lead {
    padding-left: calc(var(--cx-lead-pad) + var(--cx-pin-w, 0px));
  }
  .jx.cx-live[data-cx-rows='closed'] .cx-row {
    display: none;
  }
  .jx.cx-live[data-cx-rows='closed'] .cx-row-lead {
    visibility: hidden;
  }
  /* What the run-history dot opens, for screen readers (the rows are in the aria-hidden board). */
  .jx .cx-rows-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------- reduced motion: states land at once */

  @media (prefers-reduced-motion: reduce) {
    .jx *,
    .jx *::before,
    .jx *::after {
      animation: none !important;
      transition: none !important;
    }
  }

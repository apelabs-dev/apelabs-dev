---
// Full-bleed brand motif band (kit "C"): one flow line breaks, fragments fall, an orange repair
// bridges it, the line carries on. Dot grid between thin rules. Decorative only.
// The viewBox is cropped from the centre on narrow screens so the break stays in view.
import Blocks from './Blocks.astro';
import { repairLine, dotPath } from '../lib/motif';

const line = repairLine({ from: 0, to: 1600, at: 60, t: 12, seg: 40, breakFrom: 760, breakTo: 900 });
---

<div class="band" aria-hidden="true">
  <svg viewBox="0 0 1600 128" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path class="dots" d={dotPath(16, 16, 1584, 112, 32, 1.2)} />
    <Blocks blocks={line} />
  </svg>
</div>

<style>
  .band {
    border-block: 1px solid var(--color-rule);
    height: clamp(88px, 9vw, 128px);
    overflow: hidden;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

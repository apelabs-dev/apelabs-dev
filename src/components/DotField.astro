---
// Dot-matrix field that tiles at any size (an SVG pattern, so dots never stretch).
// Place inside a position:relative parent; it fills it and sits behind the content.
interface Props {
  id: string;
  step?: number;
}
const { id, step = 24 } = Astro.props;
---

<svg class="dotfield" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width={step} height={step} patternUnits="userSpaceOnUse">
      <circle cx={step / 2} cy={step / 2} r="1" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  .dotfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  circle {
    fill: var(--color-ink);
    fill-opacity: 0.12;
  }
</style>

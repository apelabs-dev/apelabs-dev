---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Fixed brand-asset slot; a file drop in public/og/ replaces it. */
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD objects rendered as application/ld+json. */
  jsonLd?: object[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og/og-image.png',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const onHome = Astro.url.pathname === '/';
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
// Cloudflare Web Analytics (no cookies). Rendered only when the token is set at build time.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0B0C" />

    <link rel="preload" href="/fonts/geist-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Brand kit head tags (kit favicons/head-snippet.html). Files are fixed slots in public/. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="apeLabs" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="apeLabs. We fix and build the business systems small teams run on." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="apeLabs. We fix and build the business systems small teams run on." />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
      />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header onHome={onHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 12px 16px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 560;
    text-decoration: none;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }
  .skip:focus-visible {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>

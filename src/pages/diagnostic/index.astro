---
// The canonical form URL. No-JS posts that fail come back here with ?error=… and
// functions/diagnostic/_middleware.ts reveals the matching messages.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagnostic from '../../components/sections/Diagnostic.astro';
import { PAGES, breadcrumbLd } from '../../lib/seo';

const page = PAGES.diagnostic;
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  ogDescription={page.ogDescription}
  jsonLd={[breadcrumbLd(page)]}
>
  <Diagnostic pageHeading />
</BaseLayout>

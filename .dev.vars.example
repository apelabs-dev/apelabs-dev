# Local secrets for `npm run pages:dev` (wrangler pages dev dist). Copy to .dev.vars (git-ignored).
# The values below are Cloudflare's public Turnstile TEST keys: they always pass and are safe to commit.
# Real keys go in the Pages project settings, never in this repo.

# Server-side Turnstile secret (test secret: always passes).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 1 = log "would send" instead of calling the INTAKE_MAILER Worker. Keep this on locally.
FORM_DEV_SINK=1

# 1 = accept no-JS form posts that carry no Turnstile token (a browser without JavaScript cannot run
# the widget). Honeypot, origin and size checks still apply and the email subject is marked
# "[no spam check]". Leave it unset in production unless you accept that trade-off.
NOJS_FALLBACK=1

# Build-time variables are read by `astro build`, not by wrangler. Set them in the shell or in .env:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   (test site key; a build without a key shows
#                                                         the deck's spam-check error state)
#   PUBLIC_CF_WEB_ANALYTICS_TOKEN=                      (empty = no analytics beacon)
